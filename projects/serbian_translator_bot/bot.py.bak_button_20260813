# ---------------- История диалога (в памяти) ----------------
# chat_id -> список сообщений {role, text}. Помним до 12 сообщений.
HISTORY = {}
HIST_LOCK = threading.Lock()
HIST_MAX = 12


def hist_add(chat_id, role, text):
    with HIST_LOCK:
        h = HISTORY.setdefault(chat_id, [])
        h.append({"role": role, "text": text})
        del h[:-HIST_MAX]


def hist_get(chat_id):
    with HIST_LOCK:
        return list(HISTORY.get(chat_id, []))


def hist_clear(chat_id):
    with HIST_LOCK:
        HISTORY.pop(chat_id, None)


# Последний исходный текст пользователя на chat_id (для кнопки перевода на англ.).
LAST_USER = {}
LAST_LOCK = threading.Lock()


def save_last_user(chat_id, text):
    with LAST_LOCK:
        LAST_USER[chat_id] = text


def get_last_user(chat_id):
    with LAST_LOCK:
        return LAST_USER.get(chat_id)

