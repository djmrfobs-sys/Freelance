def transcribe_groq(audio_path):
    """Whisper через Groq. Возвращает (текст, язык, ошибка).
    БЫСТРЫЙ путь: один проход с ПРИНУДИТЕЛЬНЫМ language='sr'.
    Логика: пользователь этого бота говорит ПО-СЕРБСКИ. Whisper на автопилоте
    путает сербскую речь с русской (они похожи на слух: 'могу ли добить рачун'
    вместо 'Možu li dobiti račun'), а принудительный sr возвращает ПРАВИЛЬНЫЙ
    сербский текст одним проходом. Так в 2 раза быстрее, чем двойной проход
    (авто + контрольный sr), который Артур назвал слишком медленным (пауза >20с).
    Признаки сербской кириллицы/латиницы проверяем на выходе."""
    data = {"model": "whisper-large-v3-turbo", "response_format": "verbose_json", "language": "sr"}
    with open(audio_path, "rb") as f:
        r = requests.post(
            "https://api.groq.com/openai/v1/audio/transcriptions",
            headers={"Authorization": f"Bearer {GROQ_KEY}"},
            data=data,
            files={"file": ("audio.ogg", f, "audio/ogg")},
            timeout=90,
        )
    if r.status_code != 200:
        return None, None, f"STT error {r.status_code}"
    d = r.json()
    text = d.get("text", "").strip()
    lang = d.get("language") or None
    return text, lang, None

def detect_lang_sr_ru(text):
    """Надёжно определить: сербский (латиница/кириллица), русский или английский."""
    s = set(t.lower() for t in text)
    # Сербская кириллица: специфичные буквы љ њ џ ћ ђ
    if s & set("љњџћђ"):
        return "sr"
    # Русская кириллица: буквы, которых нет в сербском (ъ ы э щ ю я ё й ц ш)
    ru_only = ("ъ", "ы", "э", "щ", "ё", "й", "ю", "я", "ц", "ш")
    if any(ch in s for ch in ru_only):
        return "ru"
    low = text.lower()
    words = {w.strip(". ,!?():;'\"-–—/").lower() for w in low.split()}

    # ---- Сербские слова-маркеры (латиница + кириллица): сильный сигнал сербского.
    # Считаем ДО проверки кириллицы, чтобы сербский (лат. без диакритик и кириллицей
    # без љ њ џ ћ ђ) не путался с русским или английским.
    sr_words = {
        # латиница
        "kako", "sta", "šta", "sto", "što", "gde", "gdje", "kada", "kad", "kuda",
        "nije", "nema", "hvala", "dobro", "zdravo", "danas", "sutra", "sada", "uvek",
        "uvek", "opet", "jos", "još", "zato", "kroz", "preko", "dok", "ako", "sve",
        "oni", "ona", "mi", "vi", "nas", "vas", "se", "sam", "si", "smo", "ste", "su",
        "je", "bilo", "bio", "bila", "ovde", "tamo", "puno", "malo", "idem", "idemo",
        "dolazim", "volim", "zelim", "želim", "moram", "probam", "imate", "imam",
        "radim", "radimo", "znam", "znate", "lepo", "brzo", "polako", "recite",
        "reći", "pomoci", "pomoći", "potreban", "kupiti", "kupujem", "stize", "stiže",
        "dolazi", "zovem", "zovemo", "cemo", "ćemo", "necu", "neću", "posle", "pre",
        "vece", "veče", "dan", "jutro", "noc", "noć", "dobrodosli", "dobrodošli",
        "kako si", "kako ste", "prijatno", "izvoli", "izvolite", "moze", "može",
        "treba", "trebam", "zelim", "želim", "sta je", "shta", "shodno", "bas", "baš",
        "naravno", "svakako", "jedan", "dva", "tri", "voda", "hleb", "hrana", "kafa",
        "svuda", "samo", "jer", "ali", "pa", "li", "da", "ne", "evo", "eto",
        # кириллица (сербская без диакритик похожа на русскую - ловим словами)
        "како", "хвала", "данас", "сутра", "добро", "здраво", "желим", "радим", "знам",
        "волим", "имам", "имате", "није", "нема", "све", "кроз", "сада", "овде", "пуно",
        "са", "је", "сам", "си", "смо", "сте", "су", "било", "био", "била",
        "добар", "вече", "дана", "добродошли", "пријатно", "молим", "изволи", "може",
        "треба", "један", "два", "три", "вода", "хлеб", "храна", "кафа", "само",
    }
    if words & sr_words:
        return "sr"

    # Доп. решающий признак: если кириллица НЕ содержит чисто русских букв (ы,э,щ,ъ,ё,я,ю,й,ц,ш)
    # и содержит сербские специфичные (љ њ џ ћ ђ) ИЛИ слово выглядит как сербский "добар/вече/добро"
    cyr_letters = [c for c in text if "\u0400" <= c <= "\u04FF"]
    ru_cyr = "ъыэщъёйюяцш"
    has_ru_cyr = any(c in ru_cyr for c in cyr_letters)
    sr_spec = "љњџћђ"
    has_sr_spec = any(c in sr_spec for c in cyr_letters)
    # Сербская кириллица без русских букв и без русских окончаний - почти наверняка сербский
    srtail = ("ва", "не", "мо", "те", "мо", "мо")
    # слово “вече/добро/како/да” в кириллице - сильный сербский сигнал
    if has_sr_spec:
        return "sr"

    # Доля кириллицы вообще
    cyr_all = "абвгдежзийклмнопрстуфхцчшщъыьэюяљњџћђ"
    letters = [c for c in text if c.isalpha()]
    cyr = sum(1 for c in letters if c.lower() in cyr_all)
    if letters and cyr / len(letters) > 0.5:
        return "ru"  # общая кириллица без сербских маркеров -> русский
    # Латиница: маркеры сербского
    sr_lat = ("š", "ž", "ć", "č", "đ", "nj", "lj", "dž")
    if any(m in low for m in sr_lat):
        return "sr"
    # Латиница без сербских диакритик — различаем английский и русский(латиницей)/сербский.
    # Частые английские слова как сигнал английского.
    en_words = {
        "the", "and", "is", "are", "i", "you", "to", "of", "it", "in", "that",
        "this", "with", "for", "on", "not", "my", "your", "hello", "hi", "please",
        "thank", "how", "what", "when", "where", "why", "dear", "can", "do", "have",
        "get", "need", "want", "good", "very", "really", "about", "from", "at", "by",
    }
    if words & en_words:
        return "en"
    # По умолчанию склоняемся к сербскому (пользователь учит сербский)
    return "sr"


def _now():
    """Текущие реальные дата и время сервера (живой момент)."""
    now = datetime.datetime.now()
    wd = ["понедельник", "вторник", "среда", "четверг", "пятница", "суббота", "воскресенье"][now.weekday()]
    return now.strftime(f"%d.%m.%Y год | {wd} | %H:%M UTC")


def translate(text, source_lang, chat_id=None):
    """Перевод через DeepSeek с учётом истории диалога (серб/рус/англ)."""
    # определим пару переводов
    if source_lang == "sr":
        target, src_hint = "русский", "сербского"
    elif source_lang == "en":
        target, src_hint = "русский", "английского"
    else:  # ru
        target, src_hint = "сербский", "русского"
    return translate_to(text, target, src_hint, chat_id=chat_id)


def translate_to(text, target, src_hint, chat_id=None, history=True):
    """Перевод через DeepSeek на указанный целевой язык. target = 'сербский'/'английский'/... ."""
    system = (
        "Ты профессиональный переводчик. Сейчас реальный момент: " + _now() + ". "
        "Переведи последнее сообщение пользователя "
        f"с {src_hint} языка на {target} язык. "
        "ВАЖНО: верни ТОЛЬКО сам перевод на " + target + " языке, БЕЗ какого-либо русского текста, "
        "без пояснений, без кавычек-разметки, без заголовков. Первым же словом начинай перевод. "
        "Никогда не повторяй исходный русский запрос и не отвечай на русском - только на " + target + ". "
        "Сохраняй смысл, тон и реалии (медицинские термины переводи точно). "
        "Ранее в разговоре был такой контекст - используй его, чтобы перевод был связным, но не цитируй его."
    )
    # собираем историю для контекста
    ctx = []
    if chat_id:
        for m in hist_get(chat_id):
            role = "user" if m["role"] == "user" else "assistant"
            ctx.append({"role": role, "content": m["text"]})
    if not ctx:
        ctx.append({"role": "system", "content": system})
        ctx.append({"role": "user", "content": text})
    else:
        ctx.insert(0, {"role": "system", "content": system})
        ctx.append({"role": "user", "content": text})
    try:
        from openai import OpenAI
        client = OpenAI(
            base_url="https://api.deepseek.com",
            api_key=DEEPSEEK_KEY,
        )
        r = client.chat.completions.create(
            model="deepseek-chat",
            messages=ctx,
            temperature=0.3,
            max_tokens=800,
        )
        return r.choices[0].message.content.strip()
    except Exception as e:
        log.error(f"translate err: {e}")
        return f"[ошибка перевода: {e}]"

# ------------------ Озвучка (Google TTS, сербский) ------------------
def tts_google(text, lang_code="sr"):
    """Бесплатный Google Translate TTS -> ogg/mp3. lang_code: 'sr' (серб)."""
    url = "https://translate.google.com/translate_tts"
    headers = {"User-Agent": "Mozilla/5.0"}
    params = {"ie": "UTF-8", "q": text[:200], "tl": lang_code, "client": "tw-ob"}
    r = requests.get(url, params=params, headers=headers, timeout=60)
    if r.status_code != 200 or len(r.content) < 1000:
        return None
    with tempfile.NamedTemporaryFile(suffix=".mp3", delete=False) as f:
        f.write(r.content)
        mp3 = f.name
    # конвертируем в ogg/opus для Telegram голосового + замедляем (atempo=0.85)
    # atempo не меняет тон голоса, просто тянет речь на ~15% медленнее — понятнее
    ogg = mp3.replace(".mp3", ".ogg")
    subprocess.run(["ffmpeg", "-y", "-i", mp3, "-filter:a", "atempo=0.85",
                    "-c:a", "libopus", "-b:a", "48k", ogg],
                   capture_output=True)
    os.unlink(mp3)
    return ogg if os.path.exists(ogg) else None

# ------------------ OCR по фото (Gemini Vision) ------------------
# Распознаём текст с картинки (сербский/русский/лат/кир).
GEMINI_KEY = open(os.path.expanduser("~/.openclaw-neuro/.gemini_key")).read().strip()
GEMINI_OCR_MODEL = "gemini-3-flash-preview"  # доступная vision-модель (2.5-flash закрыт для новых ключей)

def ocr_image(image_path):
    """Распознать текст с фото через Gemini Vision. Возвращает (text, error)."""
    import base64, json as _json
    try:
        with open(image_path, "rb") as f:
            b64 = base64.b64encode(f.read()).decode()
        body = {
            "contents": [{"parts": [
                {"inline_data": {"mime_type": "image/jpeg", "data": b64}},
                {"text": "Прочитай весь текст с этой фотографии дословно. Верни только распознанный текст, без пояснений, без перевода, без обрамления. Если текста нет — ответь одним словом: пусто"}
            ]}]
        }
        req = requests.post(
            f"https://generativelanguage.googleapis.com/v1beta/models/{GEMINI_OCR_MODEL}:generateContent?key={GEMINI_KEY}",
            json=body, timeout=90)
        if req.status_code != 200:
            return None, f"OCR HTTP {req.status_code}: {req.text[:200]}"
        d = req.json()
        # Надёжный парсинг текста из ответа Gemini (структура может различаться)
        txt = ""
        try:
            parts_list = d["candidates"][0]["content"]["parts"]
            for p in parts_list:
                if isinstance(p, dict) and p.get("text"):
                    txt += p["text"]
        except Exception:
            # резервный плоский поиск текста в ответе
            try:
                txt = _json.dumps(d)
            except Exception:
                txt = ""
        txt = (txt or "").strip()
        if not txt or txt.lower() == "пусто":
            return None, "Текст на фото не найден."
        return txt, None
    except Exception as e:
        return None, f"OCR ошибка: {e}"

# ------------------ Обработчики ------------------
def handle_text(chat_id, text):
    """Текстовый перевод: автоопределяем язык и переводим, сохраняем в историю."""
    lang = detect_lang_sr_ru(text)
    tr = translate(text, lang, chat_id=chat_id)
    if lang == "sr":
        flag = "🇷🇸 → 🇷🇺"
    elif lang == "en":
        flag = "🇬🇧 → 🇷🇺"
    else:
        flag = "🇷🇺 → 🇷🇸"
    hist_add(chat_id, "user", text)
    hist_add(chat_id, "assistant", tr)
    # СЕРБСКИЙ ПЕРЕВОД - основной текст. Кнопка перевода на англ. без авто-дубля.
    if lang == "ru":
        # нужен исходный текст (на англ. переводим именно исходник, не сербский перевод)
        save_last_user(chat_id, text)
        send_text_with_button(chat_id, f"{flag}\n\n{tr}", "🇬🇧 Перевести на английский", "to_en")
    else:
        send_text(chat_id, f"{flag}\n\n{tr}", reply_to=None)

def translate_any_to_russian(text):
    """Надёжный перевод: DeepSeek сам определяет язык исходного текста
    и переводит ВСЁ на русский. Возвращает (перевод, lang):
    lang = 'ru' (текст уже русский) | 'sr' | 'en' | 'uk' | прочее."""
    system = (
        "Ты профессиональный переводчик на русский язык. "
        "Сейчас реальный момент: " + _now() + ". "
        "Перед тобой текст: определи его язык и переведи на русский. "
        "ВАЖНО: верни ТОЛЬКО сам перевод на русском, БЕЗ пояснений, без кавычек, "
        "без обрамления, без заголовков. Первым же словом начинай перевод. "
        "Сохраняй смысл, тон и реалии (термины переводи точно)."
    )
    try:
        from openai import OpenAI
        client = OpenAI(
            base_url="https://api.deepseek.com",
            api_key=DEEPSEEK_KEY,
        )
        r = client.chat.completions.create(
            model="deepseek-chat",
            messages=[
                {"role": "system", "content": system},
                {"role": "user", "content": text},
            ],
            temperature=0.2,
            max_tokens=800,
        )
        return r.choices[0].message.content.strip(), "any"
    except Exception as e:
        log.error(f"translate_any err: {e}")
        return None, None


def handle_voice(chat_id, file_id, forced_mode=None):
    # мгновенный отклик - чтобы Telegram показывал, что бот работает, а не молчит
    send_text(chat_id, "🎙️ Распознаю и перевожу на русский...")
    try:
        # скачиваем голосовое
        fi = tg("getFile", file_id=file_id)
        if not fi.get("ok"):
            send_text(chat_id, "Не удалось получить файл 🙁")
            return
        path = fi["result"]["file_path"]
        data = requests.get(f"https://api.telegram.org/file/bot{TOKEN}/{path}", timeout=60).content
        with tempfile.NamedTemporaryFile(suffix=".oga", delete=False) as f:
            f.write(data)
            raw = f.name
        # конвертируем в ogg/wav для Whisper (Groq принимает ogg/mp3/wav)
        audio = raw + ".ogg"
        subprocess.run(["ffmpeg", "-y", "-i", raw, "-c:a", "libopus", audio], capture_output=True)
        os.unlink(raw)

        text, wlang, err = transcribe_groq(audio)
        os.unlink(audio)
        if err or not text:
            send_text(chat_id, f"Не распознал голос: {err or 'пусто'} 🙁")
            return

        log.info(f"voice transcribe: wlang={wlang!r} text={text!r}")
        # Whisper/Groq возвращает язык как ПОЛНОЕ слово ('Serbian', 'English',
        # 'Russian') или код ('sr','en','ru'). Нормализуем через contains.
        if wlang:
            wl = wlang.lower()
            if "serb" in wl or wl in ("sr",):
                lang = "sr"
            elif "eng" in wl or wl in ("en",):
                lang = "en"
            else:
                lang = "ru"
        else:
            lang = "ru"
        if lang != "ru":
            src_hint = "сербского" if lang == "sr" else "английского"
            tr = translate_to(text, "русский", src_hint, chat_id=None, history=False)
        else:
            tr = None
        hist_add(chat_id, "user", text)
        if tr:
            hist_add(chat_id, "assistant", tr)
        if lang == "en":
            flag = "🇬🇧 → 🇷🇺"
        elif lang == "sr":
            flag = "🇷🇸 → 🇷🇺"
        else:
            flag = "🇷🇺"
        if tr:
            out = f"🎙 <i>Распознано:</i> {text}\n\n{flag}\n<b>{tr}</b>"
        else:
            out = f"🎙 <i>Распознано (уже русский):</i> {text}\n\n{flag}\nТекст на русском - перевод не нужен."
        send_text(chat_id, out)
    except Exception as e:
        log.error(f"handle_voice err: {e}")
        send_text(chat_id, f"Ошибка обработки голоса: {e} 🙁")

def handle_photo(chat_id, file_id):
    """Фото на сербском: распознаём текст (OCR) и переводим на русский."""
    try:
        fi = tg("getFile", file_id=file_id)
        if not fi.get("ok"):
            send_text(chat_id, "Не удалось получить фото 🙁")
            return
        path = fi["result"]["file_path"]
        data = requests.get(f"https://api.telegram.org/file/bot{TOKEN}/{path}", timeout=120).content
        with tempfile.NamedTemporaryFile(suffix=".jpg", delete=False) as f:
            f.write(data)
            img = f.name
        send_text(chat_id, "🔎 Распознаю текст на фото...")
        text, err = ocr_image(img)
        os.unlink(img)
        if err or not text:
            send_text(chat_id, f"{err or 'Не распознал текст'} 🙁")
            return
        lang = detect_lang_sr_ru(text)
        # Переводим с реального языка фото (серб/англ/рус) на русский.
        # Фото обычно присылают с текстом на сербском или английском -> цель русский.
        if lang == "ru":
            # фото по-русски - не переводим, просто покажем текст
            tr = text
            flag = "🖼 Русский текст (перевод не нужен)"
        elif lang == "en":
            tr = translate_to(text, "русский", "английского", chat_id=None, history=False)
            flag = "🇬🇧 → 🇷🇺"
        else:  # sr
            tr = translate_to(text, "русский", "сербского", chat_id=None, history=False)
            flag = "🇷🇸 → 🇷🇺"
        hist_add(chat_id, "user", text)
        hist_add(chat_id, "assistant", tr)
        out = f"🖼 <i>Распознано:</i> {text}\n\n{flag}\n<b>{tr}</b>"
        send_text(chat_id, out)
        # озвучиваем перевод на русском (если переводили; если текст уже русский - не озвучиваем)
        if lang != "ru":
            ogg = tts_google(tr, "ru")
            if ogg:
                send_voice(chat_id, ogg, caption="🔊 Русский (озвучено)")
                os.unlink(ogg)
    except Exception as e:
        log.error(f"photo err: {e}")
        send_text(chat_id, f"Ошибка при обработке фото: {e}")

# ------------------ Цикл опроса ------------------
def get_updates(offset):
    """Забрать апдейты с коротким таймаутом и настойчиво, без зависания на 70 сек."""
    for attempt in range(3):
        try:
            r = requests.get(f"{API}/getUpdates",
                             params={"offset": offset, "timeout": 25},
                             timeout=30)
            return r.json().get("result", [])
        except Exception as e:
            log.error(f"getUpdates err (попытка {attempt+1}): {e}")
            time.sleep(1.5)
    return []

def main():
    log.info("Бот запущен")
    offset = 0
    while True:
        try:
            for upd in get_updates(offset):
                offset = upd["update_id"] + 1  # продвигаем offset СРАЗУ, чтобы не застрять на битом апдейте
                # Обработка нажатия на кнопку (перевод на английский)
                cb = upd.get("callback_query")
                cb = upd.get("callback_query")
                if cb:
                    cid = cb["message"]["chat"]["id"]
                    if cid not in AUTHORIZED:
                        continue
                    if cb["data"] == "to_en":
                        requests.post(f"{API}/answerCallbackQuery",
                                      data={"callback_query_id": cb["id"], "text": "Перевожу на английский..."}, timeout=30)
                        src = get_last_user(cid) or ""
                        if not src:
                            send_text(cid, "Нет исходного текста для перевода. Напиши что-нибудь заново.")
                        else:
                            en = translate_to(src, "английский", "русского", chat_id=None, history=False)
                            send_text(cid, f"🇷🇺 → 🇬🇧\n\n{en}")
                    continue
                msg = upd.get("message") or upd.get("edited_message")
                if not msg:
                    continue
                chat_id = msg["chat"]["id"]
                # доступ только владельцу
                if chat_id not in AUTHORIZED:
                    send_text(chat_id, "Извините, бот личный.")
                    continue
                text = msg.get("text")
                voice = msg.get("voice")
                if text and text.startswith("/"):
                    if text.startswith("/start"):
                        send_text(chat_id,
                            "🤖 <b>Переводчик</b>\n\n"
                            "📝 <b>Текст:</b> просто напиши фразу — бот сам определит язык и переведёт\n"
                            "   (сербский ⇄ русский, английский ⇄ русский)\n"
                            "🎙 <b>Голос:</b> нажми запись и говори — распознаю и переведу\n"
                            "🧠 <b>История:</b> бот помнит диалог для связности перевода\n"
                            "🗑 <b>/clear</b> — удалить всю историю разговора")
                    elif text.startswith("/clear"):
                        hist_clear(chat_id)
                        send_text(chat_id, "🗑 История разговора удалена.")
                    elif text.startswith("/sr"):
                        send_text(chat_id, "Режим: 🇷🇸 сербский → русский. Говори по-сербски.")
                    elif text.startswith("/ru"):
                        send_text(chat_id, "Режим: русский → 🇷🇸 сербский (+ озвучка). Говори по-русски.")
                    elif text.startswith("/en"):
                        send_text(chat_id, "Режим: 🇬🇧 английский → русский. Говори по-английски.")
                    else:
                        send_text(chat_id, "Неизвестная команда. Используй /start, /clear, /sr, /ru, /en.")
                elif text:
                    handle_text(chat_id, text)
                elif voice:
                    handle_voice(chat_id, voice["file_id"])
                elif msg.get("photo"):
                    handle_photo(chat_id, msg["photo"][-1]["file_id"])
        except Exception as e:
            log.error(f"loop err: {e}")
            time.sleep(3)
        time.sleep(0.5)

if __name__ == "__main__":
    main()
