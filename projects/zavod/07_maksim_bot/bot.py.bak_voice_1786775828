]

# временные маркеры: слово/часть -> сдвиг от сегодня
DATE_HINTS = {
    "сегодня": 0, "сегодня": 0, "сегодня вечером": 0,
    "завтра": 1,
    "послезавтра": 2,
}

WEEKDAY_HINTS = {
    "понедельник": 0, "в понедельник": 0,
    "вторник": 1, "во вторник": 1,
    "среду": 2, "в среду": 2,
    "четверг": 3, "в четверг": 3,
    "пятницу": 4, "в пятницу": 4,
    "субботу": 5, "в субботу": 5,
    "воскресенье": 6, "в воскресенье": 6,
}


def parse_gig_date(text):
    """Определить дату события из текста. Возвращает (date, ключ_обнаружен) или (None, None)."""
    t = (text or "").lower()
    # конкретная дата ДД.ММ[.ГГГГ]
    m = re.search(r"(\b\d{1,2}[./]\d{1,2}(?:[./]\d{2,4})?)\b", t)
    if m:
        try:
            parts = re.split(r"[./]", m.group(1))
            d, mo = int(parts[0]), int(parts[1])
            y = int(parts[2]) if len(parts) > 2 else datetime.now(TZ).year
            dt = datetime(y, mo, d).date()
            return dt, m.group(1)
        except Exception:
            pass
    # день недели
    for w, off in WEEKDAY_HINTS.items():
        if w in t:
            today = datetime.now(TZ).date()
            delta = (off - today.weekday()) % 7
            if delta == 0:
                delta = 7  # "в субботу" сегодня суббота - значит следующая
            return today + timedelta(days=delta), w.strip()
    # сегодня / завтра / послезавтра
    for key, off in DATE_HINTS.items():
        if key in t:
            return datetime.now(TZ).date() + timedelta(days=off), key
    return None, None


def detect_gig(chat_id, text):
    """Если Максим упоминает выступление/работу - запомнить на дату события.
    Если дата в будущем - также добавить в events для напоминаний."""
    t = (text or "").lower()
    hit = next((h for h in GIG_HINTS if h in t), None)
    if not hit:
        return
    gdt, marker = parse_gig_date(text)
    if gdt is None:
        gdt = datetime.now(TZ).date()  # нет даты - считаем сегодня
    gds = gdt.isoformat()
    c = db()
    exists = c.execute("SELECT 1 FROM gigs WHERE chat_id=? AND date=?",
                       (chat_id, gds)).fetchone()
    if not exists:
        c.execute("INSERT INTO gigs (chat_id, date, title) VALUES (?,?,?)",
                  (chat_id, gds, hit))
    # событие в будущем - добавим в events для напоминаний (только если его там ещё нет)
    ev_exists = c.execute("SELECT 1 FROM events WHERE chat_id=? AND date(dt)=? AND lower(title) LIKE ?",
                          (chat_id, gds, f"%{hit}%")).fetchone()
    if gdt > datetime.now(TZ).date() and not ev_exists:
        dt_val = datetime.combine(gdt, datetime.min.time()).replace(tzinfo=TZ)
        c.execute("INSERT INTO events (chat_id, title, dt) VALUES (?,?,?)",
                  (chat_id, hit, dt_val.isoformat()))
    c.commit()
    c.close()


def has_gig_today(chat_id):
    """Есть ли у Максима выступление/работа сегодня."""
    today = datetime.now(TZ).date().isoformat()
    c = db()
    row = c.execute("SELECT COUNT(*) n FROM gigs WHERE chat_id=? AND date=?",
                    (chat_id, today)).fetchone()
    c.close()
    return bool(row and row["n"] > 0)


def remind_events(chat_id, now):
    c = db()
    evs = c.execute("SELECT * FROM events WHERE chat_id=? AND dt > ?",
                    (chat_id, now.isoformat())).fetchall()
    for e in evs:
        dt = datetime.fromisoformat(e["dt"])
        diff = dt - now
        # за день (24ч) и не напоминано
        if timedelta(hours=22) < diff < timedelta(hours=26) and not e["reminded_day"]:
            c.execute("UPDATE events SET reminded_day=1 WHERE id=?", (e["id"],))
            c.commit()
            send(chat_id, f"Бро Максим, завтра у тебя {e['title']} в {dt.strftime('%H:%M')}. Ты готов?")
        # за 2 часа
        if timedelta(minutes=110) < diff < timedelta(minutes=130) and not e["reminded_2h"]:
            c.execute("UPDATE events SET reminded_2h=1 WHERE id=?", (e["id"],))
            c.commit()
            send(chat_id, f"Бро Максим, через 2 часа {e['title']}. Соберись, ты лучший!")
    c.close()


def remind_today_notes(chat_id):
    today = datetime.now(TZ).date().isoformat()
    c = db()
    pts = c.execute("SELECT * FROM notes WHERE chat_id=? AND date(ts)=?",
                    (chat_id, today)).fetchall()
    c.close()
    if pts:
        lines = "\n".join(f"- {p['text']}" for p in pts)
        send(chat_id, f"Бро Максим, твои заметки за сегодня:\n{lines}")


def send_weekly_report(chat_id):
    c = db()
    week_ago = (datetime.now(TZ) - timedelta(days=7)).isoformat()
    moods = c.execute("SELECT value FROM mood WHERE chat_id=? AND ts > ? AND value > 0",
                      (chat_id, week_ago)).fetchall()
    notes_count = c.execute("SELECT COUNT(*) n FROM notes WHERE chat_id=? AND ts > ?",
                            (chat_id, week_ago)).fetchone()["n"]
    evs = c.execute("SELECT title, dt FROM events WHERE chat_id=? AND dt > ? ORDER BY dt LIMIT 5",
                    (chat_id, datetime.now(TZ).isoformat())).fetchall()
    c.close()
    avg = round(sum(m["value"] for m in moods) / len(moods), 1) if moods else 0
    lines = [f"Бро Максим, твой отчёт за неделю:"]
    lines.append(f"Среднее состояние: {avg} / 10" if avg else "Состояние: данных пока мало")
    lines.append(f"Заметок за неделю: {notes_count}")
    if evs:
        ev_lines = ", ".join(f"{e['title']} ({e['dt'][:16].replace('T', ' ')})" for e in evs)
        lines.append(f"Впереди: {ev_lines}")
    send(chat_id, "\n".join(lines), main_kb())


# ---------------- Watchdog (самовосстановление) ----------------
HEARTBEAT = {"t": time.time()}

def watchdog_loop():
    """Следит за пульсом главного цикла. Если цикл завис дольше WATCHDOG_TIMEOUT -
    принудительно аварийно завершает процесс, systemd (Restart=always) перезапустит.
    Зависший цикл systemd не видит, поэтому такой внутренний сторож обязателен."""
    wait = 0
    while True:
        try:
            # проверяем каждые 20 сек
            diff = time.time() - HEARTBEAT["t"]
            # главный цикл обновляет HEARTBEAT при каждом апдейте/итерации
            # если пульс протух дольше 300 сек (5 мин) и никакой активности - перезапуск
            if diff > 300:
                log.error(f"Watchdog: цикл завис ({diff:.0f}s без пульса) - принудительный рестарт")
                os._exit(1)
            # предупреждение в логи, когда приближаемся к лимиту
            if diff > 240 and wait != int(diff / 60):
                wait = int(diff / 60)
                log.warning(f"Watchdog: сердцебиение почти протухло ({diff:.0f}s)")
        except Exception as e:
            log.error(f"watchdog: {e}")
        time.sleep(20)


# ---------------- Main ----------------
def main():
    init_db()
    log.info("Нейропомощник для Максима запущен")

    # планировщик в отдельном потоке
    threading.Thread(target=run_scheduler, daemon=True).start()
    # watchdog в отдельном потоке
    threading.Thread(target=watchdog_loop, daemon=True).start()

    offset = None
    offset_file = os.path.join(BASE, "last_offset_maksim.txt")
    try:
        with open(offset_file) as f:
            offset = int(f.read().strip())
    except Exception:
        pass

    # Читаем апдейты с 0 при первом запуске, НЕ проглятывая старые.
    # Иначе первое сообщение /start теряется.
    start_offset = 0
    try:
        r0 = requests.get(f"{API}/getUpdates", params={"timeout": 20}, timeout=30)
        d0 = r0.json()
        if d0.get("ok"):
            ups = d0.get("result", [])
            if ups:
                start_offset = ups[-1]["update_id"] + 1
    except Exception:
        pass

    while True:
        try:
            # обновляем сердцебиение - watchdog видит, что цикл жив
            HEARTBEAT["t"] = time.time()
            this_offset = offset if offset is not None else start_offset
            params = {"timeout": 40, "offset": this_offset}
            r = requests.get(f"{API}/getUpdates", params=params, timeout=60)
            d = r.json()
            if not d.get("ok"):
                time.sleep(2)
                continue
            seen = False
            for upd in d.get("result", []):
                new_id = upd["update_id"]
                offset = new_id + 1
                with open(offset_file, "w") as f:
                    f.write(str(offset))
                seen = True
                msg = upd.get("message") or upd.get("edited_message")
                if not msg:
                    continue
                chat_id = msg["chat"]["id"]
                text = msg.get("text")
                if not text:
                    if msg.get("voice") or msg.get("audio"):
                        send(chat_id, "Бро Максим, голосовое получил. Расшифровку подключим, а пока напиши текстом, договорились?")
                    continue
                handle_text(chat_id, text)
            if not seen and offset is None:
                # первый пустой опрос - запишем базу, чтобы не цеплять старые апдейты повторно
                offset = 0 if start_offset == 0 else offset
        except Exception as e:
            log.error(f"loop: {e}")
            time.sleep(2)
            # даже при ошибке обновляем пульс - цикл не завис, просто была сетевая ошибка
            HEARTBEAT["t"] = time.time()


if __name__ == "__main__":
    main()
