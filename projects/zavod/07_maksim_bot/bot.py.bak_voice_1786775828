def handle_text(chat_id, text):
    t = (text or "").strip()

    # админ-команда Артура: активировать доступ
    if t.startswith("/activate") and chat_id == OWNER_CHAT_ID:
        activate_admin(chat_id)
        return

    # проверка: был ли уже пройден опросник
    c = db()
    survey_done = c.execute("SELECT COUNT(*) as cnt FROM survey WHERE chat_id=? AND question_num=9",
                            (chat_id,)).fetchone()["cnt"] > 0
    c.close()
    
    # если опросник пройден и это не админ - не пускаем
    if survey_done and chat_id != OWNER_CHAT_ID:
        active, block_msg = sub_status(chat_id)
        if not active:
            send(chat_id, block_msg, main_kb())
            return
    
    # проверка подписки: 7 дней бесплатно, потом опросник
    active, block_msg = sub_status(chat_id)
    if not active and chat_id != OWNER_CHAT_ID:
        # вместо блока - начинаем опросник
        q_num = get_survey_question_num(chat_id)
        if q_num < 10:
            # опросник ещё не завершён
            send_survey_answer_response(chat_id, q_num - 1) if q_num > 0 else start_survey(chat_id)
        return
    
    # проверка: находимся ли мы в процессе опросника
    q_num = get_survey_question_num(chat_id)
    if q_num < 10 and chat_id != OWNER_CHAT_ID:
        # опросник в процессе - сохрани ответ и отправь следующий вопрос
        save_survey_answer(chat_id, q_num, t)
        send_survey_answer_response(chat_id, q_num)
        return

    # команды
    if t.startswith("/"):
        cmd = t.split()[0]
        rest = t[len(cmd):].strip()
        if cmd == "/start":
            # сначала пользовательское соглашение, потом рассказ о себе
            send(chat_id, AGREEMENT)
            send(chat_id, INTRO, mood_kb())
        elif cmd == "/заметка":
            if rest:
                c = db()
                c.execute("INSERT INTO notes (chat_id, text, ts) VALUES (?,?,?)",
                          (chat_id, rest, datetime.now(TZ).isoformat()))
                c.commit()
                c.close()
                send(chat_id, "Записал, Бро Максим. Вечером напомню.", main_kb())
            else:
                send(chat_id, "Напиши текст заметки после слова: /заметка текст")
        elif cmd == "/мероприятие":
            if rest:
                # формат: название | ДД.ММ.ГГГГ ЧЧ:ММ
                parts = rest.split("|")
                title = parts[0].strip()
                dt = parts[1].strip() if len(parts) > 1 else ""
                try:
                    dt_parsed = datetime.strptime(dt, "%d.%m.%Y %H:%M").replace(tzinfo=TZ)
                except Exception:
                    send(chat_id, "Формат: /мероприятие Название | ДД.ММ.ГГГГ ЧЧ:ММ, например: /мероприятие Свадьба Ивановых | 15.08.2026 18:00")
                    return
                c = db()
                c.execute("INSERT INTO events (chat_id, title, dt) VALUES (?,?,?)",
                          (chat_id, title, dt_parsed.isoformat()))
                c.commit()
                c.close()
                send(chat_id, f"Добавил: {title}. Напомню за день и за 2 часа.", main_kb())
            else:
                send(chat_id, "Формат: /мероприятие Название | ДД.ММ.ГГГГ ЧЧ:ММ")
        elif cmd == "/отчет" or cmd == "/итог":
            send_weekly_report(chat_id)
        elif cmd == "/привычка" or cmd == "/цель":
            # одиночная команда без текста - показать статус
            if cmd == "/привычка":
                show_habits(chat_id)
            else:
                show_goals(chat_id)
        elif cmd == "/привычка+":
            if rest:
                add_habit(chat_id, rest)
            else:
                show_habits(chat_id)
        elif cmd == "/цель+":
            if rest:
                # если число - отметить выполнение, иначе добавить цель
                if re.fullmatch(r"[1-9]\d*", rest):
                    complete_goal(chat_id, int(rest) - 1)
                else:
                    add_goal(chat_id, rest)
            else:
                show_goals(chat_id)
        else:
            send(chat_id, "Доступно: /start, /заметка текст, /мероприятие Название | дата время, /привычка, /цель, /отчет",
                 main_kb())
        return

    # кнопки
    low = t.lower()
    if low in ("моё состояние", "мое состояние", "состояние"):
        save_mood(chat_id, 0, "")
        send(chat_id, "Бро Максим, как ты сейчас? Выбери, как себя чувствуешь.", mood_kb())
        return
    if low in ("мои заметки", "заметки"):
        c = db()
        pts = c.execute("SELECT * FROM notes WHERE chat_id=? ORDER BY id DESC LIMIT 10",
                        (chat_id,)).fetchall()
        c.close()
        if pts:
            lines = "\n".join(f"- {p['text']}" for p in pts)
            send(chat_id, f"Твои заметки:\n{lines}", main_kb())
        else:
            send(chat_id, "Заметок пока нет. Напиши мысль через /заметка текст.", main_kb())
        return
    if low in ("мои привычки", "привычки"):
        show_habits(chat_id)
        return
    if low in ("мои цели", "цели"):
        show_goals(chat_id)
        return
    if low in ("мои мероприятия", "мероприятия"):
        c = db()
        evs = c.execute("SELECT * FROM events WHERE chat_id=? AND dt > ? ORDER BY dt LIMIT 10",
                        (chat_id, datetime.now(TZ).isoformat())).fetchall()
        c.close()
        if evs:
            lines = "\n".join(f"- {e['title']} ({e['dt'][:16].replace('T', ' ')})" for e in evs)
            send(chat_id, f"Твои мероприятия:\n{lines}\n\nДобавить: /мероприятие Название | ДД.ММ.ГГГГ ЧЧ:ММ", main_kb())
        else:
            send(chat_id, "Мероприятий пока нет. Добавить: /мероприятие Название | ДД.ММ.ГГГГ ЧЧ:ММ", main_kb())
        return
    if low in ("итог дня", "итог"):
        send_weekly_report(chat_id)
        return
    if low in ("расскажу подробнее", "подробнее"):
        send(chat_id, "Слушаю, Бро Максим. Пиши, не торопись. Я рядом.")
        return
    if low.startswith("/заметка"):
        return

    # слова состояния или число (шкала настроения)
    mv = mood_value(t)
    if mv is not None:
        handle_mood_scale(chat_id, t)
        return

    # распознаём упоминание выступления/мероприятия/работы и запоминаем на сегодня
    detect_gig(chat_id, t)

    # свободный диалог
    reply = free_dialog(t, chat_id)
    send(chat_id, reply, main_kb())


