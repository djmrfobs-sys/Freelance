def clean(text):
    text = text.replace("**", "").replace("*", "").replace("—", "-").replace("–", "-").replace("−", "-")
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


# ---------------- История диалога (память переписки) ----------------
DIALOG_LIMIT = 12  # сколько последних сообщений держать в контексте для DeepSeek

def save_dialog(chat_id, role, text):
    """Сохранить сообщение в историю переписки (память бота)."""
    try:
        c = db()
        c.execute("INSERT INTO dialog (chat_id, role, text, ts) VALUES (?,?,?,?)",
                  (chat_id, role, text, datetime.now(TZ).isoformat()))
        # держим последние ~150 сообщений на чат, старьё чистим
        c.execute("DELETE FROM dialog WHERE chat_id=? AND id NOT IN (SELECT id FROM dialog WHERE chat_id=? ORDER BY id DESC LIMIT 150)",
                  (chat_id, chat_id))
        c.commit()
        c.close()
    except Exception as e:
        log.error(f"save_dialog: {e}")


def get_dialog_history(chat_id, limit=DIALOG_LIMIT):
    """Последние сообщения диалога для контекста DeepSeek (память переписки)."""
    c = db()
    rows = c.execute("SELECT role, text FROM dialog WHERE chat_id=? ORDER BY id DESC LIMIT ?",
                     (chat_id, limit)).fetchall()
    c.close()
    return list(reversed(rows))


# ---------------- Telegram API ----------------
def tg(method, **params):
    try:
        r = requests.post(f"{API}/{method}", data=params, timeout=20)
        return r.json()
    except Exception as e:
        log.error(f"tg {method}: {e}")
        return {}


def send(chat_id, text, kb=None):
    text = clean(text)
    data = {"chat_id": chat_id, "text": text}
    if kb:
        data["reply_markup"] = json.dumps(kb)
    try:
        r = requests.post(f"{API}/sendMessage", data=data, timeout=20)
        return r.json()
    except Exception as e:
        log.error(f"send: {e}")
        return {}


