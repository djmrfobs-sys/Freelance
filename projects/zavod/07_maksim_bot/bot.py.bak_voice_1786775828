MOOD_WORDS = {
    "плохо": 3, "тяжело": 2, "устал": 3,
    "средне": 5, "норм": 5, "нормально": 5, "так себе": 4,
    "хорошо": 8, "ок": 8, "неплохо": 8,
    "отлично": 10, "супер": 10, "прекрасно": 10, "шикарно": 10,
}

def mood_value(text):
    """Перевести ответ в число 1-10. Слова -> уровни, цифры -> напрямую."""
    t = (text or "").strip().lower()
    if re.fullmatch(r"10|[1-9]", t):
        return int(t)
    if t in MOOD_WORDS:
        return MOOD_WORDS[t]
    return None


